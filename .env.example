# Copy to .env and adjust. Every value has a working default for a local demo.

# Claude through Spring AI. Leave empty and every AI feature falls back to the built-in rules.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Signs login tokens. Use a long random string (at least 32 characters) outside a local demo.
JWT_SECRET=change-me-to-a-long-random-string-0123456789

POSTGRES_PASSWORD=reconhub
ARTEMIS_PASSWORD=artemis

# Replay 30 days of generated files on first start (set false to start empty and use /data/inbox yourself).
DEMO_ENABLED=true

# Host ports
WEB_PORT=8080
OMS_PORT=8088
MAILPIT_PORT=8025
ARTEMIS_CONSOLE_PORT=8161
POSTGRES_PORT=5432
